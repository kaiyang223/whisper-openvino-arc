# ---------------------------------------------------------------
#  运行时产物 —— 这些是本机生成的东西，不应该进版本库
# ---------------------------------------------------------------

# Python 虚拟环境（setup.bat 会重建）
venv/
.venv/
env/

# 模型权重（几个 GB，用 tools/download_models.py 下）
models/

# 拖拽上传的临时文件
uploads/

# 默认输出目录
outputs/

# 测试音频（samples/*.wav）**随仓库分发**，这样 clone 下来就能直接跑自检
# 但转写产物不入库
samples/*.txt
samples/*.srt
samples/*.vtt
samples/*.lrc
samples/*.json
!samples/README.md

# 自检/评测的临时目录
_fmt_test/
_shot/

# ---------------------------------------------------------------
#  Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------------------------------------------------------------
#  编辑器 / 系统
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
._*

# ---------------------------------------------------------------
#  其它
